# ==============================================================================
# Invenergy Contract Intelligence Platform - Environment Configuration Template
# Copy this file to `.env` for local execution or pass these variables to Cloud Run.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Platform & Vertex AI Project Settings
# ------------------------------------------------------------------------------
# GCP Project ID where resources (BigQuery, GCS, Vertex AI, Cloud Run) reside.
GOOGLE_CLOUD_PROJECT=sophia-gcp-project-id

# Vertex AI Region for Gemini foundation model endpoints (e.g. global, us-central1).
GOOGLE_CLOUD_LOCATION=global

# Enforces Vertex AI Enterprise inference billing and quotas via google-genai SDK.
GOOGLE_GENAI_USE_ENTERPRISE=true

# ------------------------------------------------------------------------------
# 2. Gemini Foundation Models & Multi-Pass Pipeline
# ------------------------------------------------------------------------------
# Primary model for multi-pass contract structural AST decomposition & extraction.
GEMINI_MODEL=gemini-3.1-pro-preview

# Fallback model activated when 429/ResourceExhausted or quota ceiling is hit.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Fast discovery model for Pass 1 rapid boundary discovery.
FAST_DISCOVERY_MODEL=gemini-3.8-flash

# Enable 3-pass extraction (Pass 1 Discovery, Pass 2 Deep Body, Pass 3 Exhibits).
MULTI_PASS_ENABLED=true

# Maximum execution duration (seconds) before a single pass times out.
PASS_TIMEOUT_SECONDS=480.0

# Maximum output token budget for long contract analysis.
GEMINI_MAX_OUTPUT_TOKENS=65536

# Retry backoff controls for Vertex AI requests.
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_BACKOFF=2.0

# ------------------------------------------------------------------------------
# 3. Dual-Tier Lakehouse: Cloud Storage & BigQuery
# ------------------------------------------------------------------------------
# Cloud Storage bucket for raw PDF archives and CSV exports.
GCS_BUCKET_NAME=sophia-contract-intelligence

# BigQuery Dataset ID containing the 8 core contract intelligence tables & views.
BQ_DATASET_ID=contract_intelligence

# Toggle GCS and BigQuery persistence (set to false for purely local SQLite tests).
USE_CLOUD_STORAGE=true
USE_BIGQUERY=true

# Local filesystem scratch and cache directory (/tmp/data on Cloud Run, ./data locally).
LOCAL_DATA_DIR=/tmp/data

# ------------------------------------------------------------------------------
# 4. BigQuery Data Analytics Agent (Conversational Contract Analytics)
# ------------------------------------------------------------------------------
# URN of the Gemini in BigQuery Data Analytics Agent created in BigQuery Studio.
# Format: urn:agent:projects-<project-number>:projects:<project-number>:locations:<loc>:geminidataanalytics:dataAgents:<agent-id>
# Or resource name: projects/<project-number>/locations/<loc>/dataAgents/<agent-id>
# If left empty, conversational agent tab will show an unconfigured advisory banner.
BQ_DATA_AGENT_URN=urn:agent:projects-123456789012:projects:123456789012:locations:us:geminidataanalytics:dataAgents:agent_example_id

# ------------------------------------------------------------------------------
# 5. Identity Platform & Zero-Trust Authentication
# ------------------------------------------------------------------------------
# Set to 'false' only in local offline environments without network access.
AUTH_ENABLED=true

# Web API Key from Firebase Console / Google Cloud Identity Platform.
FIREBASE_API_KEY=AIzaSyExampleApiKey1234567890abcdef

# Firebase Auth Domain for passwordless email link handling.
FIREBASE_AUTH_DOMAIN=sophia-gcp-project-id.firebaseapp.com

# Comma-separated list of administrative email addresses allowed full HITL override & export permissions.
ADMIN_EMAIL_WHITELIST=aprasanna@google.com,sophia@customer.com

# ------------------------------------------------------------------------------
# 6. Observability, Structured Logging & Distributed Tracing (CR-8)
# ------------------------------------------------------------------------------
# Log format: 'json' emits Google Cloud Logging single-line structured payloads. 'text' for colorized local dev.
LOG_FORMAT=json
LOG_LEVEL=INFO

# Enable OpenTelemetry distributed tracing and export to Google Cloud Trace.
CLOUD_TRACE_ENABLED=true

# OpenTelemetry Cloud Trace batch export schedule delay in milliseconds.
CLOUD_TRACE_SCHEDULE_DELAY_MS=500

# Service naming for Cloud Trace and Cloud Logging serviceContext correlation.
TELEMETRY_SERVICE_NAME=contract-parser
TELEMETRY_SERVICE_VERSION=0.9.0

# Trace sampling rate (1.0 = 100% of traces captured for contract parsing).
TELEMETRY_SAMPLE_RATE=1.0
